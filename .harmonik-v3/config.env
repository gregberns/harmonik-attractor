# hk3 settings for the PAS fork (see harmonik-v3 docs/configuration.md).
HK3_PROJECT_PREFIX=hka
# Use the main herdr server, so remote clients attached to it see the agents.
HK3_HERDR_SESSION=default

# One handoff file per agent, so team members never overwrite each other's.
# Keep these short: hk3 session types every KEEPER_* value into the tab.
KEEPER_HANDOFF_PROMPT="Context nearly full: write HANDOFF-{name}.md with the handoff skill."
KEEPER_STARTUP_PROMPT="Read HANDOFF-{name}.md and continue."
