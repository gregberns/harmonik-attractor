#!/bin/sh
# fake-gemini: a digital twin of the Gemini CLI for PAS tests. It answers the
# `--help` format probe and prints scripted `json` or `stream-json` output
# for the scenario named in a scenario file for the node or in the node's
# prompt. See README.md next to this script.

die() {
    printf 'fake-gemini: %s\n' "$1" >&2
    exit 2
}

[ -n "${FAKE_AGENT_SCENARIOS:-}" ] || die "FAKE_AGENT_SCENARIOS is not set"
[ -d "$FAKE_AGENT_SCENARIOS" ] || die "FAKE_AGENT_SCENARIOS is not a directory: $FAKE_AGENT_SCENARIOS"

# The format probe: one line in probes.log, nothing in the other logs. The
# first line of the file gemini-help picks the answer: `json` (no
# stream-json in the help), `fail` (exit 1), `hang` (records its pid in
# probe.pid and sleeps); anything else lists stream-json.
for arg in "$@"; do
    if [ "$arg" = --help ]; then
        printf '%s\n' "$0 $* pid=$$ via=${FAKE_VIA:-}" >>"$FAKE_AGENT_SCENARIOS/probes.log"
        mode=$(head -n 1 "$FAKE_AGENT_SCENARIOS/gemini-help" 2>/dev/null)
        case $mode in
            json)
                printf '%s\n' 'Options:' '  -o, --output-format  [choices: "text", "json"]'
                ;;
            fail)
                exit 1
                ;;
            hang)
                printf '%s\n' "$$" >"$FAKE_AGENT_SCENARIOS/probe.pid"
                exec sleep 30
                ;;
            *)
                printf '%s\n' 'Options:' '  -o, --output-format  [choices: "text", "json", "stream-json"]'
                ;;
        esac
        exit 0
    fi
done

log="$FAKE_AGENT_SCENARIOS/invocations.log"
{
    printf '%s\n' '--- start' "FAKE_PID=$$"
    env | grep -E '^(PAS_|ANTHROPIC_|OPENAI_|CLAUDE_CODE_USE_)' | sort
} >>"$FAKE_AGENT_SCENARIOS/env.log"

# Log argv, one argument per line; the positional prompt (last) as <prompt>.
printf '%s\n' '--- start' >>"$log"
format=
prompt=
have_prompt=
while [ $# -gt 0 ]; do
    case $1 in
        --output-format)
            [ $# -ge 2 ] || die "$1 needs a value"
            format=$2
            printf '%s\n' "$1" "$2" >>"$log"
            shift 2
            ;;
        --approval-mode | --model)
            [ $# -ge 2 ] || die "$1 needs a value"
            printf '%s\n' "$1" "$2" >>"$log"
            shift 2
            ;;
        -*)
            die "unknown flag $1"
            ;;
        *)
            [ $# -eq 1 ] || die "the prompt must be the last argument, got $1"
            printf '%s\n' '<prompt>' >>"$log"
            prompt=$1
            have_prompt=1
            shift
            ;;
    esac
done
[ -n "$have_prompt" ] || die "a positional prompt is required"
case $format in
    json | stream-json) ;;
    *) die "--output-format json or stream-json is required, got '$format'" ;;
esac
printf '%s\n' '--- start' "$prompt" >>"$FAKE_AGENT_SCENARIOS/prompts.log"

node_file=
if [ -n "${PAS_NODE_ID:-}" ]; then
    if [ -n "${PAS_ATTEMPT:-}" ] && [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID.$PAS_ATTEMPT" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID.$PAS_ATTEMPT"
    elif [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID"
    fi
fi
if [ -n "$node_file" ]; then
    task=$(head -n 1 "$node_file")
else
    task=${prompt##*Task (}
fi

token() {
    printf '%s\n' "$task" | tr -s ' \t' '\n\n' | sed -n "s/^$1=\\([A-Za-z0-9_-]*\\).*/\\1/p" | tail -n 1
}

scenario=$(token scenario)
[ -n "$scenario" ] || die "no scenario=<name> in the scenario file or node prompt"

counter="$FAKE_AGENT_SCENARIOS/attempts.$scenario"
attempt=$(cat "$counter" 2>/dev/null || echo 0)
printf '%s\n' "$((attempt + 1))" >"$counter"

stats='{"models":{"fake-model":{"tokens":{"prompt":3,"candidates":2}}}}'
stream_stats='{"input_tokens":3,"output_tokens":2,"models":{"fake-model":{"output_tokens":2}}}'

# answer <text>: a successful answer in the requested format.
answer() {
    if [ "$format" = json ]; then
        printf '%s\n' '{"session_id":"fake","response":"'"$1"'","stats":'"$stats"'}'
    else
        printf '%s\n' '{"type":"init","model":"fake-model"}' \
            '{"type":"message","role":"assistant","content":"'"$1"'"}' \
            '{"type":"result","status":"success","stats":'"$stream_stats"'}'
    fi
}

case $scenario in
    success)
        answer 'fake-gemini: success'
        ;;
    failure)
        if [ "$format" = json ]; then
            printf '%s\n' '{"session_id":"fake","error":{"type":"Error","message":"fake-gemini: failed","code":1}}'
        else
            printf '%s\n' '{"type":"init","model":"fake-model"}' \
                '{"type":"result","status":"error","error":{"message":"fake-gemini: failed"},"stats":'"$stream_stats"'}'
        fi
        exit 1
        ;;
    crash)
        printf '%s\n' 'fake-gemini: crashed' >&2
        exit 3
        ;;
    garbage)
        printf '%s\n' 'fake-gemini: this is not json'
        ;;
    hang)
        exec sleep "${FAKE_HANG_SECS:-30}"
        ;;
    *)
        die "unknown scenario $scenario"
        ;;
esac
