#!/bin/sh
# fake-codex: a digital twin of `codex exec --json` for PAS tests. It prints
# scripted Codex JSONL for the scenario named in a scenario file for the node
# or in the node's prompt. See README.md next to this script.

die() {
    printf 'fake-codex: %s\n' "$1" >&2
    exit 2
}

[ -n "${FAKE_AGENT_SCENARIOS:-}" ] || die "FAKE_AGENT_SCENARIOS is not set"
[ -d "$FAKE_AGENT_SCENARIOS" ] || die "FAKE_AGENT_SCENARIOS is not a directory: $FAKE_AGENT_SCENARIOS"
log="$FAKE_AGENT_SCENARIOS/invocations.log"

# Log the environment PAS gives the agent, and this process's pid.
{
    printf '%s\n' '--- start' "FAKE_PID=$$"
    env | grep -E '^(PAS_|ANTHROPIC_|OPENAI_|CLAUDE_CODE_USE_)' | sort
} >>"$FAKE_AGENT_SCENARIOS/env.log"

# Log argv, one argument per line; the positional prompt (the last
# argument, often multi-line) is logged as <prompt>.
printf '%s\n' '--- start' >>"$log"
prompt=
have_prompt=
resume_id=
previous=
while [ $# -gt 0 ]; do
    arg=$1
    case $1 in
        resume)
            # `exec resume <thread id>`: continue that thread.
            [ "$previous" = exec ] || die "resume must follow exec"
            [ $# -ge 2 ] || die "resume needs a thread id"
            printf '%s\n' "$1" "$2" >>"$log"
            resume_id=$2
            shift 2
            ;;
        exec | --json | --yolo | --skip-git-repo-check | --ephemeral | \
            --dangerously-bypass-approvals-and-sandbox)
            printf '%s\n' "$1" >>"$log"
            shift
            ;;
        --cd)
            # `exec resume` has no --cd: its cwd is already the workdir.
            [ -z "$resume_id" ] || die "exec resume takes no --cd"
            [ $# -ge 2 ] || die "$1 needs a value"
            printf '%s\n' "$1" "$2" >>"$log"
            shift 2
            ;;
        --model)
            [ $# -ge 2 ] || die "$1 needs a value"
            printf '%s\n' "$1" "$2" >>"$log"
            shift 2
            ;;
        -*)
            die "unknown flag $1"
            ;;
        *)
            [ $# -eq 1 ] || die "the prompt must be the last argument, got $1"
            printf '%s\n' '<prompt>' >>"$log"
            prompt=$1
            have_prompt=1
            shift
            ;;
    esac
    previous=$arg
done
[ -n "$have_prompt" ] || die "a positional prompt is required"
printf '%s\n' '--- start' "$prompt" >>"$FAKE_AGENT_SCENARIOS/prompts.log"
# Count this node's starts and keep each start's and attempt's prompt, as
# fake-claude does.
node_start=
if [ -n "${PAS_NODE_ID:-}" ]; then
    starts="$FAKE_AGENT_SCENARIOS/starts.$PAS_NODE_ID"
    node_start=$(cat "$starts" 2>/dev/null || echo 0)
    node_start=$((node_start + 1))
    printf '%s\n' "$node_start" >"$starts"
    printf '%s\n' "$prompt" >"$FAKE_AGENT_SCENARIOS/prompt.$PAS_NODE_ID@$node_start"
fi
if [ -n "${PAS_NODE_ID:-}" ] && [ -n "${PAS_ATTEMPT:-}" ]; then
    printf '%s\n' "$prompt" >"$FAKE_AGENT_SCENARIOS/prompt.$PAS_NODE_ID.$PAS_ATTEMPT"
fi

# The scenario text, as fake-claude finds it: the file <node>@<start>, then
# <node>.<attempt>, then <node>, else the node's own prompt after the last
# "Task (".
node_file=
if [ -n "${PAS_NODE_ID:-}" ]; then
    if [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID@$node_start" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID@$node_start"
    elif [ -n "${PAS_ATTEMPT:-}" ] && [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID.$PAS_ATTEMPT" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID.$PAS_ATTEMPT"
    elif [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID"
    fi
fi
if [ -n "$node_file" ]; then
    task=$(head -n 1 "$node_file")
else
    task=${prompt##*Task (}
fi

token() {
    printf '%s\n' "$task" | tr -s ' \t' '\n\n' | sed -n "s/^$1=\\([A-Za-z0-9_-]*\\).*/\\1/p" | tail -n 1
}

scenario=$(token scenario)
[ -n "$scenario" ] || die "no scenario=<name> in the scenario file or node prompt"
label=$(token label)

counter="$FAKE_AGENT_SCENARIOS/attempts.$scenario"
attempt=$(cat "$counter" 2>/dev/null || echo 0)
printf '%s\n' "$((attempt + 1))" >"$counter"

# message <text>: an agent_message item. <text> is plain ASCII without quotes
# or backslashes, or holds a JSON escape such as \n.
message() {
    printf '%s\n' '{"type":"item.completed","item":{"id":"item_1","type":"agent_message","text":"'"$1"'"}}'
}

# The thread: the resumed one, else a fresh id made from this process's pid.
thread="00000000-0000-4000-8000-$(printf '%012d' "$$")"
[ -z "$resume_id" ] || thread=$resume_id

started() {
    printf '%s\n' '{"type":"thread.started","thread_id":"'"$thread"'"}' \
        '{"type":"turn.started"}'
}

completed() {
    printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":3,"cached_input_tokens":0,"output_tokens":2}}'
}

case $scenario in
    success)
        started
        message 'fake-codex: success'
        completed
        ;;
    label)
        [ -n "$label" ] || die "scenario label needs label=<label>"
        started
        message "fake-codex: routed\\n$label"
        completed
        ;;
    turn_failed)
        started
        message 'fake-codex: partial'
        printf '%s\n' '{"type":"turn.failed","error":{"message":"fake-codex: turn failed"}}'
        exit 1
        ;;
    crash)
        printf '%s\n' 'fake-codex: crashed' >&2
        exit 3
        ;;
    thread_not_found)
        # What `codex exec resume <id>` does when it has no such thread: no
        # JSON, the reason on stderr, exit 1.
        [ -n "$resume_id" ] || die "scenario thread_not_found needs exec resume <id>"
        printf '%s\n' "fake-codex: Error: thread/resume failed: no rollout found for thread id $resume_id" >&2
        exit 1
        ;;
    garbage)
        printf '%s\n' 'fake-codex: this is not json' '{"type":' 'garbage'
        ;;
    silent) ;;
    hang)
        started
        exec sleep "${FAKE_HANG_SECS:-30}"
        ;;
    *)
        die "unknown scenario $scenario"
        ;;
esac
