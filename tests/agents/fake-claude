#!/bin/sh
# fake-claude: a digital twin of `claude -p` for PAS tests. It prints
# scripted stream-json for the scenario named in a scenario file for the node
# or in the node's prompt.
# See README.md next to this script for the contract and how to add a scenario.

die() {
    printf 'fake-claude: %s\n' "$1" >&2
    exit 2
}

[ -n "${FAKE_AGENT_SCENARIOS:-}" ] || die "FAKE_AGENT_SCENARIOS is not set"
[ -d "$FAKE_AGENT_SCENARIOS" ] || die "FAKE_AGENT_SCENARIOS is not a directory: $FAKE_AGENT_SCENARIOS"
log="$FAKE_AGENT_SCENARIOS/invocations.log"

# Log the environment PAS gives the agent, and this process's pid (the fake
# is exec'd directly, so $$ is the agent's pid). grep finding nothing is fine.
{
    printf '%s\n' '--- start' "FAKE_PID=$$"
    env | grep -E '^(PAS_|ANTHROPIC_|OPENAI_|CLAUDE_CODE_USE_)' | sort
} >>"$FAKE_AGENT_SCENARIOS/env.log"

# Log argv, one argument per line, leaving out the multi-line -p value.
printf '%s\n' '--- start' >>"$log"
prompt=
have_prompt=
while [ $# -gt 0 ]; do
    printf '%s\n' "$1" >>"$log"
    case $1 in
        -p)
            [ $# -ge 2 ] || die "-p needs a value"
            prompt=$2
            have_prompt=1
            shift 2
            ;;
        --output-format | --setting-sources | --mcp-config | --settings | \
            --tools | --agents | --plugin-dir | --model | --allowedTools | \
            --max-budget-usd)
            [ $# -ge 2 ] || die "$1 needs a value"
            printf '%s\n' "$2" >>"$log"
            shift 2
            ;;
        --verbose | --no-session-persistence | --dangerously-skip-permissions | \
            --strict-mcp-config | --disable-slash-commands | --safe-mode | --bare)
            shift
            ;;
        *)
            die "unknown flag $1"
            ;;
    esac
done
[ -n "$have_prompt" ] || die "-p is required"
printf '%s\n' '--- start' "$prompt" >>"$FAKE_AGENT_SCENARIOS/prompts.log"
# Each attempt's prompt on its own, named by PAS_NODE_ID and PAS_ATTEMPT.
if [ -n "${PAS_NODE_ID:-}" ] && [ -n "${PAS_ATTEMPT:-}" ]; then
    printf '%s\n' "$prompt" >"$FAKE_AGENT_SCENARIOS/prompt.$PAS_NODE_ID.$PAS_ATTEMPT"
fi

# The scenario text, first match wins: the first line of the file
# <node>.<attempt>, then of the file <node>, in $FAKE_AGENT_SCENARIOS (named by
# PAS_NODE_ID and PAS_ATTEMPT); else the node's own prompt, the text after the
# last "Task (". The text before it holds the goal and earlier nodes' results.
node_file=
if [ -n "${PAS_NODE_ID:-}" ]; then
    if [ -n "${PAS_ATTEMPT:-}" ] && [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID.$PAS_ATTEMPT" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID.$PAS_ATTEMPT"
    elif [ -f "$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID" ]; then
        node_file="$FAKE_AGENT_SCENARIOS/$PAS_NODE_ID"
    fi
fi
if [ -n "$node_file" ]; then
    task=$(head -n 1 "$node_file")
else
    task=${prompt##*Task (}
fi

# The value of the last `<key>=<value>` token in the scenario text.
token() {
    printf '%s\n' "$task" | tr -s ' \t' '\n\n' | sed -n "s/^$1=\\([A-Za-z0-9_-]*\\).*/\\1/p" | tail -n 1
}

scenario=$(token scenario)
[ -n "$scenario" ] || die "no scenario=<name> in the scenario file or node prompt"
label=$(token label)
fails=$(token fails)
fails=${fails:-1}
code=$(token exit)
code=${code:-0}
case $code in
    *[!0-9]*) die "exit=<N> needs a number, got $code" ;;
esac

# Count every start of this scenario.
counter="$FAKE_AGENT_SCENARIOS/attempts.$scenario"
attempt=$(cat "$counter" 2>/dev/null || echo 0)
attempt=$((attempt + 1))
printf '%s\n' "$attempt" >"$counter"

session="00000000-0000-4000-8000-$(printf '%012d' "$$")"

init() {
    json='{"type":"system","subtype":"init","session_id":"'"$session"'","tools":["Bash","Edit","Read","Write"],"model":"fake-model","claude_code_version":"fake"}'
    printf '%s\n' "$json"
}

# assistant <text>: one assistant text message. <text> is plain ASCII without
# quotes or backslashes, so it needs no JSON escaping.
assistant() {
    json='{"type":"assistant","message":{"model":"fake-model","type":"message","role":"assistant","content":[{"type":"text","text":"'"$1"'"}],"usage":{"input_tokens":1,"output_tokens":1}},"session_id":"'"$session"'"}'
    printf '%s\n' "$json"
}

# result <subtype> <is_error> <text>: the final result line. <text> may hold
# a JSON escape such as \n.
result() {
    json='{"type":"result","subtype":"'"$1"'","is_error":'"$2"',"result":"'"$3"'","session_id":"'"$session"'","num_turns":1,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}'
    printf '%s\n' "$json"
}

succeed() {
    init
    assistant "$1"
    result success false "$1"
}

hang() {
    init
    exec sleep "${FAKE_HANG_SECS:-30}"
}

# wait_for_go: poll every 0.05 s for the file go, for at most 10 s by the
# clock (a count of sleeps would overrun where starting `sleep` is slow).
wait_for_go() {
    start=$(date +%s)
    while [ ! -f "$FAKE_AGENT_SCENARIOS/go" ]; do
        [ $(($(date +%s) - start)) -lt 10 ] || die "no go file after 10 s"
        sleep 0.05
    done
}

case $scenario in
    success)
        succeed 'fake-claude: success'
        ;;
    fail)
        # With label=<L>, the failure text ends with the label on its own
        # line, as a diamond agent's would.
        text='fake-claude: failed'
        [ -n "$label" ] && text="$text\\n$label"
        init
        assistant 'fake-claude: failed'
        result error_during_execution true "$text"
        exit 1
        ;;
    error_max_turns)
        init
        assistant 'fake-claude: out of turns'
        result error_max_turns false 'fake-claude: out of turns'
        ;;
    label)
        [ -n "$label" ] || die "scenario label needs label=<label>"
        succeed "fake-claude: routed\\n$label"
        ;;
    crash)
        init
        assistant 'fake-claude: working'
        printf '%s\n' 'fake-claude: crashed' >&2
        exit 3
        ;;
    crash_after_result)
        succeed 'fake-claude: success'
        printf '%s\n' 'fake-claude: crashed after result' >&2
        exit 3
        ;;
    garbage)
        printf '%s\n' 'fake-claude: this is not json' '{"type":' 'garbage'
        ;;
    silent) ;;
    hang)
        hang
        ;;
    stderr_live)
        init
        printf '%s\n' 'fake-claude: working' >&2
        wait_for_go
        printf '%s\n' 'fake-claude: done' >&2
        assistant 'fake-claude: success'
        result success false 'fake-claude: success'
        ;;
    hang_term)
        trap 'echo term >"$FAKE_AGENT_SCENARIOS/term"; exit 143' TERM
        init
        sleep 30 &
        wait $!
        ;;
    hang_ignore_term)
        trap 'echo term >>"$FAKE_AGENT_SCENARIOS/term"' TERM
        init
        while :; do
            sleep 1 &
            wait $!
        done
        ;;
    slow)
        init
        for part in one two three; do
            sleep 0.2
            assistant "fake-claude: part $part"
        done
        result success false 'fake-claude: slow done'
        ;;
    edit_commit)
        printf '%s\n' 'written by fake-claude' >fake-edit.txt
        git add fake-edit.txt || exit 3
        git -c user.name=fake-claude -c user.email=fake-claude@example.invalid \
            -c commit.gpgsign=false commit -q -m 'fake-claude edit' || exit 3
        succeed 'fake-claude: edited and committed'
        ;;
    edit_hang)
        printf '%s\n' 'partial work by fake-claude' >partial.txt
        hang
        ;;
    commit_hang)
        printf '%s\n' 'committed by fake-claude' >committed.txt
        git add committed.txt || exit 3
        git -c user.name=fake-claude -c user.email=fake-claude@example.invalid \
            -c commit.gpgsign=false commit -q -m 'fake-claude commit' || exit 3
        : >"$FAKE_AGENT_SCENARIOS/committed"
        hang
        ;;
    pas_dir)
        mkdir -p .pas && echo x >.pas/x
        printf '%s\n' 'visible by fake-claude' >visible.txt
        succeed 'fake-claude: success'
        ;;
    flaky)
        if [ "$attempt" -le "$fails" ]; then
            hang
        fi
        succeed 'fake-claude: success'
        ;;
    bad_result)
        init
        json='{"type":"result","subtype":"success","is_error":false,"num_turns":"many"}'
        printf '%s\n' "$json"
        exit "$code"
        ;;
    stdin)
        bytes=$(cat | wc -c | tr -d ' ')
        printf '%s\n' "$bytes" >"$FAKE_AGENT_SCENARIOS/stdin.bytes"
        succeed 'fake-claude: success'
        ;;
    *)
        die "unknown scenario $scenario"
        ;;
esac
